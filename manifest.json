{
  "manifest_version": 3,
  "name": "Pica",
  "description": "Gras, italique, souligné, barré, code, citation, liste à puces, liste numérotée, lien, image, spoiler, tableau et plus encore, directement dans l'éditeur Linkedin.",
  "version": "1.0.0",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": [
        "src/core/unicode.js",
        "src/core/layout.js",
        "src/core/settings.js",
        "src/platform/storage.js",
        "src/core/typography.js",
        "src/core/markdown.js",
        "src/platform/editor.js",
        "src/platform/ui-host.js",
        "src/core/features.js",
        "src/widgets/content.js",
        "src/widgets/overlay.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "permissions": ["storage"],
  "action": {
    "default_title": "Pica - Réglages",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
